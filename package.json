{
  "name": "personal-job-search-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-3417}",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-3417}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/install-hooks.mjs",
    "jobs": "tsx scripts/cli.ts",
    "jobs:find": "tsx scripts/cli.ts find",
    "jobs:score": "tsx scripts/cli.ts score",
    "jobs:tailor": "tsx scripts/cli.ts tailor",
    "jobs:answers": "tsx scripts/cli.ts answers",
    "jobs:prefill": "tsx scripts/cli.ts prefill",
    "jobs:submit": "tsx scripts/cli.ts submit",
    "jobs:prep": "tsx scripts/cli.ts prep",
    "cvs": "tsx scripts/cli.ts cvs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "diff": "^9.0.0",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
